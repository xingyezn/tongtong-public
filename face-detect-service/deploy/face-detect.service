[Unit]
Description=Face detection HTTP service (YOLOv11n-face-v2 INT8 + OpenVINO)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/face-detect-service
Environment=PYTHONUNBUFFERED=1
Environment=OV_NUM_THREADS=2
Environment=FACE_DETECT_MODEL=/opt/face-detect-service/model/int8_openvino_model
Environment=FACE_DETECT_PORT=8090
ExecStartPre=/bin/bash /opt/face-detect-service/deploy/setup-port-monitor.sh
ExecStart=/opt/face-detect-service/venv/bin/python app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
